<template>
  <div class="page">
    <text class="title">选择控件</text>
    <text class="label">音量 Slider</text>
    <slider class="slider" min="0" max="100" step="5" value="40" onchange="onSlider"></slider>
    <text class="readout">Slider change: value / isFromUser</text>
    <text class="label">模式 Picker</text>
    <picker class="picker" mode="text" range="安静|标准|性能" selected="1" onchange="onPicker"></picker>
    <text class="readout">Picker change: selected / value</text>
    <input class="button" type="button" value="完成" onclick="onDone" />
  </div>
</template>

<script>
export default {
  private: { volume: 40, mode: 1 },
  onSlider(event) { this.volume = Number(event && event.value) || this.volume },
  onPicker(event) { this.mode = Number(event && event.selected) || this.mode },
  onDone() {},
}
</script>

