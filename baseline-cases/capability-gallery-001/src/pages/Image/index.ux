<template>
  <div class="page">
    <text class="title">Image</text>
    <image class="image" src="assets/images/showcase.png" />
    <text class="state">本地 32x32 PNG 资源</text>
    <input class="action" type="button" value="切换资源状态" onclick="onToggle" />
    <text if="{{ ready }}" class="success">资源已加载</text>
    <text if="{{ !ready }}" class="failure">资源状态待确认</text>
    <input class="back" type="button" value="返回能力画廊" onclick="onBack" />
  </div>
</template>
<script>
import router from '@system.router'
export default {
  private: { ready: true },
  onToggle() { this.ready = !this.ready },
  onBack() { router.back() },
}
</script>
