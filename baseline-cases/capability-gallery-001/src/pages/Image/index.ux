.page { width: 300px; height: 560px; padding: 18px; flex-direction: column; align-items: center; background-color: #ffffff; }
.title { margin: 4px; font-size: 26px; color: #111111; }
.image { width: 64px; height: 64px; margin: 28px 4px 12px 4px; }
.state, .success, .failure { margin: 4px; font-size: 14px; color: #555555; }
.success { color: #00a800; } .failure { color: #d24a3a; }
.action, .back { width: 210px; height: 38px; margin: 10px 4px 4px 4px; color: #ffffff; border-radius: 6px; }
