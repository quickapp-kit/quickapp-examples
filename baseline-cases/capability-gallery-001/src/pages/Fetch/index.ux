<template>
  <div class="page">
    <text class="title">system.fetch</text>
    <text class="state">{{ state }}</text>
    <input class="action" type="button" value="请求本地状态" onclick="onFetch" />
    <text if="{{ result }}" class="result">{{ result }}</text>
    <input class="back" type="button" value="返回能力画廊" onclick="onBack" />
  </div>
</template>
<script>
import router from '@system.router'
import fetch from '@system.fetch'
export default {
  private: { state: '等待 local://platform/status', result: '' },
  onFetch() {
    this.state = '请求已发出'
    fetch.fetch({ url: 'local://platform/status', responseType: 'json' }).then(value => {
      this.state = 'Fetch completed'
      this.result = String(value && value.responseBody)
    }).catch(error => {
      this.state = 'Fetch unsupported/failed'
      this.result = String(error && error.code)
    })
  },
  onBack() { router.back() },
}
</script>
<style>
.page { width: 300px; height: 560px; padding: 18px; flex-direction: column; background-color: #ffffff; }
.title { margin: 4px 4px 28px 4px; font-size: 24px; color: #111111; }
.state, .result { width: 250px; margin: 8px 4px; font-size: 14px; color: #555555; }
.action, .back { width: 220px; height: 40px; margin: 12px 4px 4px 4px; color: #ffffff; border-radius: 6px; }
.action { background-color: #2774c7; } .back { background-color: #555555; }
</style>
