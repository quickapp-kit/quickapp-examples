<template>
  <div class="page">
    <text class="count">{{ count }}</text>
    <input class="button" type="button" value="Increment" onclick="increment" />
  </div>
</template>

<script>
export default {
  private: {
    count: 0,
  },

  increment() {
    this.count += 1
  },
}
</script>

<style>
.page {
  width: 320px;
  height: 240px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.count {
  font-size: 24px;
}

.button {
  width: 120px;
  height: 40px;
  margin-top: 16px;
  font-size: 16px;
}
</style>
