<template>
  <div class="page">
    <image class="detail-icon" src="assets/images/target.png" />
    <text class="detail-name">{{ goalName }}</text>
    <text class="detail-value">{{ currentValue }}</text>
    <text class="detail-desc">{{ progressText }}</text>
    <input class="back-btn" type="button" value="返回" onclick="onBack" />
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'

export default {
  private: {
    goalName: '步行',
    currentValue: '6842 步',
    progressText: '距目标还差 3158 步',
  },

  onInit() {
    const selected = globalThis.__qak_band_selection__
    if (selected === 'calories') {
      this.goalName = '消耗'
      this.currentValue = '186 kcal'
      this.progressText = '距目标还差 114 kcal'
    } else if (selected === 'stand') {
      this.goalName = '站立'
      this.currentValue = '5 小时'
      this.progressText = '距目标还差 3 小时'
    } else if (selected === 'water') {
      this.goalName = '饮水'
      this.currentValue = '6 杯'
      this.progressText = '距目标还差 2 杯'
    }
  },

  onBack() {
    prompt.showToast({ message: '已返回目标列表', duration: 0 })
    router.back()
  },
}
</script>

<style>
.page { width: 194px; height: 368px; flex-direction: column; align-items: center; justify-content: center; background-color: #0f0f1a; padding: 16px 12px 16px 12px; }
.detail-icon { width: 32px; height: 32px; margin: 0px 0px 10px 0px; }
.detail-name { font-size: 18px; color: #ffffff; text-align: center; margin: 0px 0px 6px 0px; }
.detail-value { font-size: 28px; color: #00d4aa; text-align: center; margin: 0px 0px 8px 0px; }
.detail-desc { font-size: 12px; color: #8892b0; text-align: center; margin: 0px 0px 16px 0px; }
.back-btn { width: 120px; height: 36px; border-radius: 18px; background-color: #4ecdc4; color: #0f0f1a; font-size: 13px; }
</style>
