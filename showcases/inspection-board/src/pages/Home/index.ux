<template>
  <div class="page">
    <text class="title">设备巡检</text>
    <text class="summary-note">{{ summaryNote }}</text>
    <input class="action" type="button" value="手动刷新" onclick="onRefresh" />
    <text if="{{ loading }}" class="state">正在刷新巡检状态</text>
    <div class="summary">
      <image class="summary-image" src="assets/images/inspection.png" />
      <image class="summary-image" src="assets/images/inspection-review.png" />
      <image class="summary-image" src="assets/images/inspection-alert.png" />
      <text class="summary-text">正常 / 待复核 / 异常</text>
    </div>
    <div class="list" for="{{ (index, item) in items }}" tid="id">
      <image class="item-image" src="assets/images/inspection.png" />
      <text class="item-title">{{ item.title }}</text>
      <text class="item-status">{{ item.status }}</text>
      <input class="detail" type="button" value="查看详情" onclick="onDetail" />
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'

export default {
  private: {
    itemCount: 3,
    refreshCount: 0,
    loading: false,
    summaryNote: '本地巡检样例 / 条目 3 / 刷新 0',
    items: [
      { id: 'pumpA', title: '一号泵站', status: '正常' },
      { id: 'valveB', title: '二号阀组', status: '待复核' },
      { id: 'panelC', title: '控制面板', status: '异常' },
    ],
  },

  onRefresh() {
    this.refreshCount += 1
    this.loading = !this.loading
    if (this.refreshCount % 3 === 1) {
      this.items = [
        { id: 'valveB', title: '二号阀组', status: '正常' },
        { id: 'panelC', title: '控制面板', status: '待复核' },
        { id: 'pumpA', title: '一号泵站', status: '异常' },
      ]
    } else if (this.refreshCount % 3 === 2) {
      this.items = [
        { id: 'panelC', title: '控制面板', status: '正常' },
        { id: 'pumpA', title: '一号泵站', status: '待复核' },
        { id: 'valveB', title: '二号阀组', status: '异常' },
      ]
    } else {
      this.items = [
        { id: 'pumpA', title: '一号泵站', status: '正常' },
        { id: 'valveB', title: '二号阀组', status: '待复核' },
        { id: 'panelC', title: '控制面板', status: '异常' },
      ]
    }
    this.summaryNote = '本地巡检样例 / 条目 ' + this.itemCount + ' / 刷新 ' + this.refreshCount
    prompt.showToast({ message: '巡检状态已刷新', duration: 0 })
  },

  onDetail(event) {
    const handler = String(event && event.handlerId)
    if (handler.endsWith('-valveB')) {
      globalThis.__qak_gallery_selection__ = 'valveB'
    } else if (handler.endsWith('-panelC')) {
      globalThis.__qak_gallery_selection__ = 'panelC'
    } else {
      globalThis.__qak_gallery_selection__ = 'pumpA'
    }
    prompt.showToast({ message: '正在打开巡检详情', duration: 0 })
    router.push({ uri: '/pages/Detail' })
  },
}
</script>

<style>
.page {
  width: 300px;
  height: 560px;
  padding: 12px 12px 12px 12px;
  flex-direction: column;
  align-items: center;
  background-color: #ffffff;
}
.title { margin: 4px 4px 4px 4px; font-size: 24px; color: #111111; }
.summary-note, .state, .summary-text { margin: 3px 3px 3px 3px; font-size: 14px; color: #555555; }
.action { width: 220px; height: 42px; margin: 4px 4px 8px 4px; border-radius: 8px; background-color: #00a800; color: #ffffff; }
.summary { width: 260px; height: 50px; margin: 2px 4px 2px 4px; flex-direction: row; align-items: center; background-color: #f7f8f8; }
.summary-image { width: 24px; height: 24px; margin: 3px 3px 3px 3px; }
.summary-text { margin-left: 6px; }
.list { width: 260px; height: 74px; margin: 3px 4px 3px 4px; padding: 4px 6px 4px 6px; flex-direction: row; align-items: center; background-color: #f2f4f5; border-radius: 6px; }
.item-image { width: 32px; height: 32px; margin: 4px 8px 4px 4px; }
.item-title { font-size: 15px; color: #111111; }
.item-status { margin: 2px 2px 2px 0px; font-size: 13px; color: #39744a; }
.detail { width: 88px; height: 26px; border-radius: 5px; background-color: #2774c7; color: #ffffff; }
</style>
