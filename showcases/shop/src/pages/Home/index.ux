.setting { width: 100%; height: 42px; margin: 3px 0 3px 0; padding: 4px 5px; flex-direction: row; align-items: center; background-color: #ffffff; border-radius: 5px; }
.setting-name { width: 40%; font-size: 13px; color: #111111; }
.setting-value { width: 60%; font-size: 11px; color: #777777; }
.panel-title { margin: 2px 2px 10px 2px; font-size: 20px; color: #111111; }
.panel-body { margin: 3px 2px 3px 2px; font-size: 14px; color: #555555; }
.tabs { width: 100%; height: 48px; background-color: #2774c7; color: #ffffff; border-radius: 6px; }
</style>
