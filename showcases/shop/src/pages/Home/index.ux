.panel { width: 100%; height: 150px; margin: 12px 0 4px 0; padding: 18px 12px 12px 12px; flex-direction: column; background-color: #f2f4f5; border-radius: 7px; }
.seed-panel { height: 470px; }
.seed-grid { width: 100%; flex-direction: row; align-items: flex-start; justify-content: space-between; }
.seed-column { width: 48%; flex-direction: column; }
.seed-card { width: 100%; margin: 4px 0 3px 0; padding: 5px; flex-direction: column; align-items: center; background-color: #ffffff; border-radius: 6px; }
.seed-tall { height: 98px; }
.seed-short { height: 78px; }
.seed-image { width: 48px; height: 48px; margin: 2px 8px 2px 2px; }
.seed-copy, .cart-copy { flex-direction: column; }
.seed-title, .cart-title { font-size: 14px; color: #111111; }
.seed-body, .panel-note { margin-top: 3px; font-size: 11px; color: #777777; }
.seed-video { width: 100%; height: 150px; margin: 8px 0 4px 0; background-color: #20252b; border-radius: 6px; }
.cart-list { width: 100%; height: 140px; flex-direction: column; }
.cart-panel { width: 100%; height: 300px; margin: 12px 0 4px 0; padding: 18px 12px 12px 12px; flex-direction: column; background-color: #f2f4f5; border-radius: 7px; }
.cart-item { width: 100%; height: 58px; margin: 4px 0 3px 0; padding: 5px; flex-direction: row; align-items: center; background-color: #ffffff; border-radius: 6px; }
.cart-image { width: 42px; height: 42px; margin: 2px 8px 2px 2px; }
.cart-copy { width: 52%; }
.cart-price { margin-top: 3px; font-size: 12px; color: #d24a3a; }
.cart-detail { width: 52px; height: 28px; border-radius: 5px; background-color: #2774c7; color: #ffffff; }
.cart-footer { width: 100%; height: 48px; margin: 4px 0 4px 0; flex-direction: row; align-items: center; justify-content: space-between; }
.cart-total { margin: 0 2px 0 2px; font-size: 17px; color: #d24a3a; }
.pay { width: 150px; height: 42px; margin: 0 2px 0 2px; border-radius: 21px; background-color: #f2b632; color: #ffffff; }
.cart-status { margin: 0 2px 2px 2px; font-size: 11px; color: #777777; }
.me-panel { width: 100%; height: 300px; margin: 12px 0 4px 0; padding: 18px 12px 12px 12px; flex-direction: column; background-color: #f2f4f5; border-radius: 7px; }
.account { width: 100%; height: 58px; margin: 0 0 8px 0; flex-direction: row; align-items: center; }
.avatar { width: 48px; height: 48px; margin: 0 10px 0 2px; text-align: center; font-size: 22px; color: #ffffff; background-color: #2774c7; border-radius: 24px; }
