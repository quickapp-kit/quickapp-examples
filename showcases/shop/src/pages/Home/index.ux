          </div>
          <div class="product" for="{{ (index, item) in selectedTab === 0 ? bagProducts : [] }}" tid="id">
            <image class="product-image" src="assets/images/product-focus.png" />
            <div class="product-copy">
              <text class="product-title">{{ item.title }}</text>
              <text class="product-meta">{{ item.category }} / {{ item.status }}</text>
              <text class="product-price">{{ item.price }}</text>
            </div>
            <input class="detail" type="button" value="查看详情" onclick="onProduct" />
          </div>
          <div class="product" for="{{ (index, item) in selectedTab === 0 ? cupProducts : [] }}" tid="id">
            <image class="product-image" src="assets/images/product-review.png" />
            <div class="product-copy">
              <text class="product-title">{{ item.title }}</text>
              <text class="product-meta">{{ item.category }} / {{ item.status }}</text>
              <text class="product-price">{{ item.price }}</text>
            </div>
            <input class="detail" type="button" value="查看详情" onclick="onProduct" />
          </div>
        </div>

        <div class="panel seed-panel" if="{{ selectedTab === 1 }}">
          <text class="panel-title">种草</text>
          <text class="panel-body">本地精选内容 / 两列卡片流</text>
          <div class="seed-grid">
            <div class="seed-column">
              <div class="seed-card seed-tall">
                <image class="seed-image" src="assets/images/product-focus.png" />
                <div class="seed-copy">
                  <text class="seed-title">通勤收纳怎么选</text>
                  <text class="seed-body">轻量背包，装下工作日常</text>
                </div>
              </div>
              <div class="seed-card seed-short">
                <image class="seed-image" src="assets/images/product-review.png" />
                <div class="seed-copy">
                  <text class="seed-title">随行饮品搭配</text>
                  <text class="seed-body">保温杯与城市出行</text>
                </div>
              </div>
            </div>
            <div class="seed-column">
              <div class="seed-card seed-short">
                <image class="seed-image" src="assets/images/product-main.png" />
                <div class="seed-copy">
                  <text class="seed-title">桌面灯光布置</text>
                  <text class="seed-body">工作区的暖光方案</text>
                </div>
              </div>
              <div class="seed-card seed-tall">
                <image class="seed-image" src="assets/images/product-focus.png" />
                <div class="seed-copy">
                  <text class="seed-title">周末轻装出发</text>
                  <text class="seed-body">一只包的短途清单</text>
                </div>
              </div>
            </div>
          </div>
          <video class="seed-video" src="assets/videos/seed-demo.mp4" poster="assets/images/product-focus.png" controls="true" muted="true" autoplay="false" onprepared="onVideoPrepared" onstart="onVideoStart" onpause="onVideoPause" onfinish="onVideoFinish" onerror="onVideoError"></video>
        </div>

        <text if="{{ selectedTab === 2 }}" class="panel-title">购物车</text>
        <text if="{{ selectedTab === 2 }}" class="panel-body">{{ cartItems.length }} 件商品 / 本地暂存</text>
        <text if="{{ selectedTab === 2 && cartItems.length === 0 }}" class="panel-body">购物车为空</text>
        <div class="cart-list" if="{{ selectedTab === 2 }}">
          <div class="cart-item">
            <image class="cart-image" src="assets/images/product-main.png" />
            <div class="cart-copy">
              <text class="cart-title">晨光便携灯</text>
              <text class="cart-price">129 元</text>
            </div>
            <input class="cart-detail" type="button" value="详情" onclick="onLampCartProduct" />
          </div>
          <div class="cart-item">
            <image class="cart-image" src="assets/images/product-focus.png" />
            <div class="cart-copy">
              <text class="cart-title">城市通勤包</text>
              <text class="cart-price">299 元</text>
            </div>
            <input class="cart-detail" type="button" value="详情" onclick="onBagCartProduct" />
          </div>
        </div>
        <text if="{{ selectedTab === 3 }}" class="panel-title">我的</text>
        <div if="{{ selectedTab === 3 }}" class="account">
          <text class="avatar">人</text>
          <div class="account-copy">
            <text class="login">请登录</text>
            <text class="account-note">登录后查看收藏、足迹和购物记录</text>
          </div>
        </div>
        <div class="settings-list" if="{{ selectedTab === 3 }}">
          <div class="setting" for="{{ (index, item) in selectedTab === 3 ? settings : [] }}" tid="id">
            <text class="setting-name">{{ item.name }}</text>
            <text class="setting-value">{{ item.value }}</text>
          </div>
        </div>
      </div>
    </scroll>

    <div class="cart-footer" if="{{ selectedTab === 2 }}">
      <text class="cart-total">合计：{{ cartTotal }} 元</text>
      <input class="pay" type="button" value="去结算（演示）" onclick="onPay" />
    </div>
    <text if="{{ selectedTab === 2 && paid }}" class="cart-status">支付按钮已点击 / 仅演示</text>

    <tabs class="tabs" items="首页|种草|购物车|我的" selected="{{ selectedTab }}" onchange="onTabChange"></tabs>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'

export default {
  private: {
    selectedTab: 0,
    videoState: '等待播放',
    paid: false,
    cartTotal: 428,
    cartItems: [
      { id: 'cartLamp', title: '晨光便携灯', price: '129 元' },
      { id: 'cartBag', title: '城市通勤包', price: '299 元' },
    ],
    settings: [
      { id: 'favorites', name: '收藏夹', value: '3 件' },
      { id: 'preferences', name: '设置', value: '已配置' },
      { id: 'orders', name: '购物记录', value: '8 笔' },
      { id: 'returns', name: '退换货', value: '无进行中' },
      { id: 'service', name: '人工客服', value: '在线帮助' },
      { id: 'coupons', name: '优惠券', value: '2 张' },
      { id: 'history', name: '浏览记录', value: '8 条' },
      { id: 'address', name: '收货地址', value: '本地演示地址' },
      { id: 'payment', name: '支付方式', value: '已绑定' },
      { id: 'notify', name: '消息通知', value: '已开启' },
      { id: 'membership', name: '会员权益', value: '普通会员' },
      { id: 'invoice', name: '发票管理', value: '未设置' },
      { id: 'about', name: '关于我们', value: '版本 1.0' },
      { id: 'privacy', name: '隐私设置', value: '默认保护' },
      { id: 'cache', name: '清理缓存', value: '0 MB' },
      { id: 'help', name: '帮助中心', value: '常见问题' },
      { id: 'logout', name: '退出登录', value: '体验模式' },
    ],
    products: [
      { id: 'lampA', title: '晨光便携灯', category: '家居', status: '热卖', price: '129 元' },
      { id: 'bagB', title: '城市通勤包', category: '出行', status: '精选', price: '299 元' },
      { id: 'cupC', title: '轻量保温杯', category: '生活', status: '上新', price: '89 元' },
      { id: 'lampD', title: '夜读护眼灯', category: '家居', status: '精选', price: '159 元' },
      { id: 'bagE', title: '轻便旅行袋', category: '出行', status: '热卖', price: '239 元' },
      { id: 'cupF', title: '随行咖啡杯', category: '生活', status: '上新', price: '79 元' },
      { id: 'lampG', title: '桌面氛围灯', category: '家居', status: '精选', price: '199 元' },
      { id: 'bagH', title: '城市双肩包', category: '出行', status: '热卖', price: '329 元' },
      { id: 'cupI', title: '简约玻璃杯', category: '生活', status: '稳定', price: '59 元' },
      { id: 'lampJ', title: '床头阅读灯', category: '家居', status: '上新', price: '179 元' },
      { id: 'bagK', title: '通勤收纳包', category: '出行', status: '精选', price: '189 元' },
      { id: 'cupL', title: '随手保温杯', category: '生活', status: '热卖', price: '99 元' },
      { id: 'lampM', title: '便携露营灯', category: '家居', status: '上新', price: '219 元' },
      { id: 'bagN', title: '周末旅行包', category: '出行', status: '稳定', price: '269 元' },
      { id: 'cupO', title: '轻巧随行杯', category: '生活', status: '精选', price: '69 元' },
      { id: 'lampP', title: '小夜灯套装', category: '家居', status: '热卖', price: '149 元' },
      { id: 'bagQ', title: '轻量电脑包', category: '出行', status: '上新', price: '359 元' },
      { id: 'cupR', title: '透明冷水壶', category: '生活', status: '稳定', price: '119 元' },
      { id: 'lampS', title: '阅读工作灯', category: '家居', status: '精选', price: '249 元' },
      { id: 'bagT', title: '短途旅行包', category: '出行', status: '热卖', price: '289 元' },
    ],
    lampProducts: [
      { id: 'lampA', title: '晨光便携灯', category: '家居', status: '热卖', price: '129 元' },
      { id: 'lampD', title: '夜读护眼灯', category: '家居', status: '精选', price: '159 元' },
      { id: 'lampG', title: '桌面氛围灯', category: '家居', status: '精选', price: '199 元' },
      { id: 'lampJ', title: '床头阅读灯', category: '家居', status: '上新', price: '179 元' },
      { id: 'lampM', title: '便携露营灯', category: '家居', status: '上新', price: '219 元' },
      { id: 'lampP', title: '小夜灯套装', category: '家居', status: '热卖', price: '149 元' },
      { id: 'lampS', title: '阅读工作灯', category: '家居', status: '精选', price: '249 元' },
    ],
    bagProducts: [
      { id: 'bagB', title: '城市通勤包', category: '出行', status: '精选', price: '299 元' },
      { id: 'bagE', title: '轻便旅行袋', category: '出行', status: '热卖', price: '239 元' },
      { id: 'bagH', title: '城市双肩包', category: '出行', status: '热卖', price: '329 元' },
      { id: 'bagK', title: '通勤收纳包', category: '出行', status: '精选', price: '189 元' },
      { id: 'bagN', title: '周末旅行包', category: '出行', status: '稳定', price: '269 元' },
      { id: 'bagQ', title: '轻量电脑包', category: '出行', status: '上新', price: '359 元' },
      { id: 'bagT', title: '短途旅行包', category: '出行', status: '热卖', price: '289 元' },
    ],
    cupProducts: [
      { id: 'cupC', title: '轻量保温杯', category: '生活', status: '上新', price: '89 元' },
      { id: 'cupF', title: '随行咖啡杯', category: '生活', status: '上新', price: '79 元' },
      { id: 'cupI', title: '简约玻璃杯', category: '生活', status: '稳定', price: '59 元' },
      { id: 'cupL', title: '随手保温杯', category: '生活', status: '热卖', price: '99 元' },
      { id: 'cupO', title: '轻巧随行杯', category: '生活', status: '精选', price: '69 元' },
      { id: 'cupR', title: '透明冷水壶', category: '生活', status: '稳定', price: '119 元' },
    ],
  },

  onTabChange(event) {
    if (event && Number.isInteger(event.index)) {
      this.selectedTab = event.index
      if (event.index === 2 && this.cartItems.length === 2 && globalThis.__qak_commerce_cart_item__) {
        const selected = globalThis.__qak_commerce_cart_item__
        if (selected === 'bagB') {
          this.cartItems = this.cartItems.concat([{ id: 'cartAddedBag', title: '城市通勤包', price: '299 元' }])
          this.cartTotal += 299
        } else if (selected === 'cupC') {
          this.cartItems = this.cartItems.concat([{ id: 'cartAddedCup', title: '轻量保温杯', price: '89 元' }])
          this.cartTotal += 89
        } else {
          this.cartItems = this.cartItems.concat([{ id: 'cartAddedLamp', title: '晨光便携灯', price: '129 元' }])
          this.cartTotal += 129
        }
      }
    }
  },

  onProduct(event) {
    const handler = String(event && event.handlerId)
    if (handler.endsWith('-bagB')) globalThis.__qak_commerce_selection__ = 'bagB'
    else if (handler.endsWith('-cupC')) globalThis.__qak_commerce_selection__ = 'cupC'
    else if (handler.endsWith('-lampD')) globalThis.__qak_commerce_selection__ = 'lampD'
    else if (handler.endsWith('-bagE')) globalThis.__qak_commerce_selection__ = 'bagE'
    else if (handler.endsWith('-cupF')) globalThis.__qak_commerce_selection__ = 'cupF'
    else if (handler.endsWith('-lampG')) globalThis.__qak_commerce_selection__ = 'lampG'
    else if (handler.endsWith('-bagH')) globalThis.__qak_commerce_selection__ = 'bagH'
    else if (handler.endsWith('-cupI')) globalThis.__qak_commerce_selection__ = 'cupI'
    else if (handler.endsWith('-lampJ')) globalThis.__qak_commerce_selection__ = 'lampJ'
    else if (handler.endsWith('-bagK')) globalThis.__qak_commerce_selection__ = 'bagK'
    else if (handler.endsWith('-cupL')) globalThis.__qak_commerce_selection__ = 'cupL'
    else if (handler.endsWith('-lampM')) globalThis.__qak_commerce_selection__ = 'lampM'
    else if (handler.endsWith('-bagN')) globalThis.__qak_commerce_selection__ = 'bagN'
    else if (handler.endsWith('-cupO')) globalThis.__qak_commerce_selection__ = 'cupO'
    else if (handler.endsWith('-lampP')) globalThis.__qak_commerce_selection__ = 'lampP'
    else if (handler.endsWith('-bagQ')) globalThis.__qak_commerce_selection__ = 'bagQ'
    else if (handler.endsWith('-cupR')) globalThis.__qak_commerce_selection__ = 'cupR'
    else if (handler.endsWith('-lampS')) globalThis.__qak_commerce_selection__ = 'lampS'
    else if (handler.endsWith('-bagT')) globalThis.__qak_commerce_selection__ = 'bagT'
    else globalThis.__qak_commerce_selection__ = 'lampA'
    prompt.showToast({ message: '打开商品详情', duration: 0 })
    router.push({ uri: '/pages/ProductDetail' })
  },

  onLampCartProduct() {
    globalThis.__qak_commerce_selection__ = 'lampA'
    router.push({ uri: '/pages/ProductDetail' })
  },

  onBagCartProduct() {
    globalThis.__qak_commerce_selection__ = 'bagB'
    router.push({ uri: '/pages/ProductDetail' })
  },

  onPay() {
    this.paid = true
    prompt.showToast({ message: '支付按钮已点击（演示）', duration: 0 })
  },

  onVideoPrepared() { this.videoState = '已准备' },
  onVideoStart() { this.videoState = '播放中' },
  onVideoPause() { this.videoState = '已暂停' },
  onVideoFinish() { this.videoState = '播放完成' },
  onVideoError() { this.videoState = '播放失败' },
}
</script>

<style>
.page { width: 100%; height: 100%; padding: 10px 12px 10px 12px; flex-direction: column; justify-content: flex-start; background-color: #ffffff; }
.header { width: 100%; height: 28px; flex-direction: column; }
.title { margin: 0 4px 1px 4px; font-size: 25px; color: #111111; }
