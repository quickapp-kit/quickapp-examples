<template>
  <div class="page detail-page">
    <input class="top-back" type="button" value="返回" onclick="onBack" />
    <scroll class="detail-scroll">
      <div class="detail-content">
        <image class="hero" src="assets/images/product-main.png" />
        <text class="title">{{ detailTitle }}</text>
        <text class="meta">{{ detailMeta }}</text>
        <div class="price-row">
          <text class="price">{{ detailPrice }}</text>
          <text class="sale">已售 1.2 万+</text>
        </div>
        <text class="tags">本地精选  ·  快速配送  ·  售后保障</text>
        <div class="info-section">
          <text class="section-title">配送与服务</text>
          <text class="section-body">本地体验 · 预计今日送达 · 支持七天无理由</text>
        </div>
        <div class="info-section">
          <text class="section-title">规格</text>
          <text class="section-body">标准版 / 默认配置</text>
        </div>
        <div class="info-section">
          <text class="section-title">商品说明</text>
          <text class="section-body">轻量便携，适合桌面、通勤和日常使用。</text>
        </div>
        <text if="{{ added }}" class="result success">已加入购物车</text>
        <text if="{{ purchased }}" class="result purchased">下单状态：演示提交成功</text>
        <div class="actions">
          <input class="add" type="button" value="加入购物车" onclick="onAdd" />
          <input class="buy" type="button" value="立即购买" onclick="onBuy" />
        </div>
        <input class="back" type="button" value="返回首页" onclick="onBack" />
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'

export default {
  private: {
    detailTitle: '晨光便携灯',
    detailMeta: '家居 / 热卖',
    detailPrice: '129 元',
    added: false,
    purchased: false,
  },

  onInit() {
    const selected = globalThis.__qak_commerce_selection__
    if (selected === 'bagB') {
      this.detailTitle = '城市通勤包'
      this.detailMeta = '出行 / 精选'
      this.detailPrice = '299 元'
    } else if (selected === 'cupC') {
      this.detailTitle = '轻量保温杯'
      this.detailMeta = '生活 / 上新'
      this.detailPrice = '89 元'
    } else if (selected === 'lampD') {
      this.detailTitle = '夜读护眼灯'
      this.detailMeta = '家居 / 精选'
      this.detailPrice = '159 元'
    } else if (selected === 'bagE') {
      this.detailTitle = '轻便旅行袋'
      this.detailMeta = '出行 / 热卖'
      this.detailPrice = '239 元'
    } else if (selected === 'cupF') {
      this.detailTitle = '随行咖啡杯'
      this.detailMeta = '生活 / 上新'
      this.detailPrice = '79 元'
    } else if (selected === 'lampG') {
      this.detailTitle = '桌面氛围灯'
      this.detailMeta = '家居 / 精选'
      this.detailPrice = '199 元'
    } else if (selected === 'bagH') {
      this.detailTitle = '城市双肩包'
      this.detailMeta = '出行 / 热卖'
      this.detailPrice = '329 元'
    } else if (selected === 'cupI') {
      this.detailTitle = '简约玻璃杯'
      this.detailMeta = '生活 / 稳定'
      this.detailPrice = '59 元'
    } else if (selected === 'lampJ') {
      this.detailTitle = '床头阅读灯'
      this.detailMeta = '家居 / 上新'
      this.detailPrice = '179 元'
    } else if (selected === 'bagK') {
      this.detailTitle = '通勤收纳包'
      this.detailMeta = '出行 / 精选'
      this.detailPrice = '189 元'
    } else if (selected === 'cupL') {
      this.detailTitle = '随手保温杯'
      this.detailMeta = '生活 / 热卖'
      this.detailPrice = '99 元'
    } else if (selected === 'lampM') {
      this.detailTitle = '便携露营灯'
      this.detailMeta = '家居 / 上新'
      this.detailPrice = '219 元'
    } else if (selected === 'bagN') {
      this.detailTitle = '周末旅行包'
      this.detailMeta = '出行 / 稳定'
      this.detailPrice = '269 元'
    } else if (selected === 'cupO') {
      this.detailTitle = '轻巧随行杯'
      this.detailMeta = '生活 / 精选'
      this.detailPrice = '69 元'
    } else if (selected === 'lampP') {
      this.detailTitle = '小夜灯套装'
      this.detailMeta = '家居 / 热卖'
      this.detailPrice = '149 元'
    } else if (selected === 'bagQ') {
      this.detailTitle = '轻量电脑包'
      this.detailMeta = '出行 / 上新'
      this.detailPrice = '359 元'
    } else if (selected === 'cupR') {
      this.detailTitle = '透明冷水壶'
      this.detailMeta = '生活 / 稳定'
      this.detailPrice = '119 元'
    } else if (selected === 'lampS') {
      this.detailTitle = '阅读工作灯'
      this.detailMeta = '家居 / 精选'
      this.detailPrice = '249 元'
    } else if (selected === 'bagT') {
      this.detailTitle = '短途旅行包'
      this.detailMeta = '出行 / 热卖'
      this.detailPrice = '289 元'
    }
  },

  onAdd() {
    globalThis.__qak_commerce_cart_item__ = globalThis.__qak_commerce_selection__ || 'lampA'
    this.added = true
    prompt.showToast({ message: '已加入购物车', duration: 0 })
  },
  onBuy() {
    this.purchased = true
    prompt.showToast({ message: '下单状态已更新', duration: 0 })
  },
  onBack() { router.back() },
}
</script>

<style>
