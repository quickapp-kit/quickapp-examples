.price { margin: 2px 4px 4px 4px; font-size: 24px; color: #d24a3a; }
.sale { margin: 2px 4px 4px 4px; font-size: 12px; color: #777777; }
.tags { width: 100%; margin: 3px 4px 10px 4px; font-size: 12px; color: #39744a; }
.info-section { width: 100%; margin: 4px 0 3px 0; padding: 9px 10px 8px 10px; flex-direction: column; background-color: #f2f4f5; border-radius: 6px; }
.section-title { margin: 1px 2px 4px 2px; font-size: 15px; color: #111111; }
.section-body { margin: 1px 2px 1px 2px; font-size: 12px; color: #555555; }
.result { width: 100%; margin: 7px 4px 2px 4px; font-size: 13px; }
.success { color: #00a800; }
.purchased { color: #2774c7; }
.actions { width: 100%; margin: 10px 0 4px 0; flex-direction: row; justify-content: space-between; }
.add, .buy { width: 48%; height: 40px; border-radius: 7px; color: #ffffff; }
.add { background-color: #e98b28; }
.buy { background-color: #d24a3a; }
