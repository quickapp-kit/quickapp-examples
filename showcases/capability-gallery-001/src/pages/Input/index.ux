<template>
  <div class="page">
    <text class="title">Input</text>
    <input class="field" type="text" value="QuickApp" oninput="onInput" onchange="onChange" onfocus="onFocus" />
    <text class="state">当前值：{{ value }}</text>
    <text if="{{ focused }}" class="success">focus/input/change 已接收</text>
    <input class="back" type="button" value="返回能力画廊" onclick="onBack" />
  </div>
</template>
<script>
import router from '@system.router'
export default {
  private: { value: 'QuickApp', focused: false },
  onInput(event) { if (event && event.value) this.value = event.value },
  onChange(event) { if (event && event.value) this.value = event.value },
  onFocus() { this.focused = true },
  onBack() { router.back() },
}
</script>
<style>
.page { width: 300px; height: 560px; padding: 18px; flex-direction: column; background-color: #ffffff; }
.title { margin: 4px 4px 28px 4px; font-size: 26px; color: #111111; }
.field { width: 250px; height: 40px; margin: 4px; background-color: #f2f4f5; color: #111111; border-radius: 5px; }
.state, .success { margin: 12px 4px; font-size: 14px; color: #555555; }
.success { color: #00a800; }
.back { width: 210px; height: 38px; margin: 22px 4px; background-color: #555555; color: #ffffff; border-radius: 6px; }
</style>
