<template>
  <div class="page">
    <text class="title">Tabs</text>
    <tabs class="tabs" items="概览|任务|我的" selected="{{ selected }}" onchange="onChange"></tabs>
    <text class="state">当前索引：{{ selected }}</text>
    <text if="{{ selected === 0 }}" class="content">概览：运行正常</text>
    <text if="{{ selected === 1 }}" class="content">任务：3 项待处理</text>
    <text if="{{ selected === 2 }}" class="content">我的：QuickApp Kit</text>
    <input class="back" type="button" value="返回能力画廊" onclick="onBack" />
  </div>
</template>
<script>
import router from '@system.router'
export default {
  private: { selected: 0 },
  onChange(event) { if (event && Number.isInteger(event.index)) this.selected = event.index },
  onBack() { router.back() },
}
</script>
<style>
.page { width: 300px; height: 560px; padding: 18px; flex-direction: column; background-color: #ffffff; }
.title { margin: 4px 4px 20px 4px; font-size: 26px; color: #111111; }
.tabs { width: 250px; height: 44px; margin: 4px; background-color: #2774c7; color: #ffffff; border-radius: 6px; }
.state, .content { margin: 18px 4px 4px 4px; font-size: 15px; color: #555555; }
.content { color: #2774c7; }
.back { width: 210px; height: 38px; margin: 30px 4px; background-color: #555555; color: #ffffff; border-radius: 6px; }
</style>
