<template>
  <div class="page">
    <text class="title">Slider</text>
    <slider class="slider" min="0" max="100" step="5" value="40" onchange="onChange"></slider>
    <text class="state">当前值：{{ value }}</text>
    <text if="{{ changed }}" class="success">change 事件已回传</text>
    <input class="back" type="button" value="返回能力画廊" onclick="onBack" />
  </div>
</template>
<script>
import router from '@system.router'
export default {
  private: { value: 40, changed: false },
  onChange(event) { this.value = Number(event && event.value) || this.value; this.changed = true },
  onBack() { router.back() },
}
</script>
<style>
.page { width: 300px; height: 560px; padding: 18px; flex-direction: column; background-color: #ffffff; }
.title { margin: 4px 4px 36px 4px; font-size: 26px; color: #111111; }
.slider { width: 250px; height: 36px; margin: 4px; }
.state, .success { margin: 18px 4px 4px 4px; font-size: 15px; color: #555555; }
.success { color: #00a800; }
.back { width: 210px; height: 38px; margin: 28px 4px; background-color: #555555; color: #ffffff; border-radius: 6px; }
</style>
