<template>
  <div class="page">
    <text class="title">system.prompt</text>
    <text class="state">{{ state }}</text>
    <input class="action" type="button" value="显示 Toast" onclick="onPrompt" />
    <text if="{{ submitted }}" class="success">请求已通过 typed Feature Bridge</text>
    <input class="back" type="button" value="返回能力画廊" onclick="onBack" />
  </div>
</template>
<script>
import router from '@system.router'
import prompt from '@system.prompt'
export default {
  private: { state: '等待操作', submitted: false },
  onPrompt() { prompt.showToast({ message: 'Capability Gallery prompt', duration: 0 }); this.state = 'prompt.showToast 已提交'; this.submitted = true },
  onBack() { router.back() },
}
</script>
<style>
.page { width: 300px; height: 560px; padding: 18px; flex-direction: column; background-color: #ffffff; }
.title { margin: 4px 4px 28px 4px; font-size: 24px; color: #111111; }
.state, .success { margin: 8px 4px; font-size: 14px; color: #555555; } .success { color: #00a800; }
.action, .back { width: 220px; height: 40px; margin: 12px 4px 4px 4px; color: #ffffff; border-radius: 6px; }
.action { background-color: #2774c7; } .back { background-color: #555555; }
</style>
