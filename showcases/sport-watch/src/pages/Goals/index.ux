<template>
  <div class="page">
    <text class="title">今日目标</text>
    <text if="{{ allDone }}" class="all-done">全部完成</text>
    <div class="icons-row">
      <image class="top-icon" src="assets/images/steps.png" />
      <image class="top-icon" src="assets/images/heart.png" />
      <image class="top-icon" src="assets/images/fire.png" />
      <image class="top-icon" src="assets/images/water.png" />
    </div>
    <scroll class="goal-scroll">
      <list class="goal-list">
        <div class="goal-item" for="{{ (index, item) in goals }}" tid="id">
          <image class="goal-icon" src="assets/images/target.png" />
          <text class="goal-name">{{ item.name }}</text>
          <text class="goal-progress">{{ item.current }}/{{ item.target }}</text>
          <text class="goal-done">{{ item.done ? '✓' : '' }}</text>
          <input class="goal-btn" type="button" value="详情" onclick="onDetail" />
        </div>
      </list>
    </scroll>
    <input class="refresh-btn" type="button" value="返回" onclick="onBack" />
  </div>
</template>

<script>
import router from '@system.router'

export default {
  private: {
    allDone: false,
    goals: [
      { id: 'steps', name: '步行', current: '6842', target: '10000', done: false },
      { id: 'calories', name: '消耗', current: '186', target: '300', done: false },
      { id: 'stand', name: '站立', current: '5', target: '8', done: false },
      { id: 'water', name: '饮水', current: '6', target: '8', done: false },
    ],
  },

  onBack() {
    router.back()
  },

  onDetail(event) {
    const handler = String(event && event.handlerId)
    let selected = 'steps'
    if (handler.includes('calories')) selected = 'calories'
    else if (handler.includes('stand')) selected = 'stand'
    else if (handler.includes('water')) selected = 'water'
    globalThis.__qak_fitness_selection__ = selected
    router.push({ uri: '/pages/Detail' })
  },
}
</script>

<style>
.page { width: 240px; height: 240px; flex-direction: column; align-items: center; justify-content: center; background-color: #1a1a2e; }
.title { font-size: 16px; color: #ffffff; text-align: center; margin: 0px 0px 2px 0px; }
.all-done { font-size: 12px; color: #00d4aa; text-align: center; margin: 0px 0px 2px 0px; }
.icons-row { width: 152px; height: 20px; flex-direction: row; align-items: center; justify-content: center; margin: 0px 0px 3px 0px; }
.top-icon { width: 16px; height: 16px; margin: 0px 5px 0px 5px; }
.goal-scroll { width: 184px; height: 140px; }
.goal-list { width: 184px; height: 160px; flex-direction: column; align-items: center; }
.goal-item { width: 180px; height: 34px; margin: 2px 0px 2px 0px; padding: 2px 3px 2px 3px; flex-direction: row; align-items: center; background-color: #16213e; border-radius: 6px; }
.goal-icon { width: 16px; height: 16px; margin: 0px 3px 0px 0px; }
.goal-name { width: 28px; font-size: 11px; color: #ffffff; }
.goal-progress { width: 66px; font-size: 10px; color: #8892b0; }
.goal-done { width: 12px; font-size: 12px; color: #00d4aa; text-align: center; }
.goal-btn { width: 38px; height: 22px; border-radius: 11px; background-color: #4ecdc4; color: #1a1a2e; font-size: 10px; }
.refresh-btn { width: 92px; height: 26px; margin: 3px 0px 0px 0px; border-radius: 13px; background-color: #00d4aa; color: #1a1a2e; font-size: 12px; }
</style>
