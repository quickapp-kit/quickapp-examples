<template>
  <div class="page">
    <text class="title">今日目标</text>
    <text if="{{ allDone }}" class="all-done">全部完成</text>
    <scroll class="goal-scroll">
      <list class="goal-list">
        <div class="goal-item">
          <image class="goal-icon" src="assets/images/goal-square.png" />
          <text class="goal-name">步行</text><text class="goal-progress">6842/10000</text>
          <input class="goal-btn steps-btn" type="button" value="详情" onclick="onStepsDetail" />
        </div>
        <div class="goal-item">
          <image class="goal-icon" src="assets/images/goal-circle.png" />
          <text class="goal-name">消耗</text><text class="goal-progress">186/300</text>
          <input class="goal-btn calories-btn" type="button" value="详情" onclick="onCaloriesDetail" />
        </div>
        <div class="goal-item">
          <image class="goal-icon" src="assets/images/goal-triangle.png" />
          <text class="goal-name">站立</text><text class="goal-progress">5/8</text>
          <input class="goal-btn stand-btn" type="button" value="详情" onclick="onStandDetail" />
        </div>
        <div class="goal-item">
          <image class="goal-icon" src="assets/images/goal-diamond.png" />
          <text class="goal-name">饮水</text><text class="goal-progress">6/8</text>
          <input class="goal-btn water-btn" type="button" value="详情" onclick="onWaterDetail" />
        </div>
      </list>
    </scroll>
    <input class="refresh-btn" type="button" value="返回" onclick="onBack" />
  </div>
</template>

<script>
import router from '@system.router'

export default {
  private: {
    allDone: false,
  },

  onBack() {
    router.back()
  },

  onStepsDetail() { this.openDetail('steps') },
  onCaloriesDetail() { this.openDetail('calories') },
  onStandDetail() { this.openDetail('stand') },
  onWaterDetail() { this.openDetail('water') },
  openDetail(selected) {
    router.push({ uri: '/pages/Detail', params: { goal: selected } })
  },
}
</script>

