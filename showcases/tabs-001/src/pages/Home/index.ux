<template>
  <div class="page">
    <text class="title">QuickApp Kit</text>
    <text class="subtitle">受控 Tabs</text>
    <tabs class="tabs" items="首页|任务|我的" selected="{{ selected }}" onchange="onTabChange"></tabs>
    <text class="selection">当前页面：{{ selected }}</text>
    <text if="{{ selected === 0 }}" class="content">首页：运行状态正常</text>
    <text if="{{ selected === 1 }}" class="content">任务：3 项待处理</text>
    <text if="{{ selected === 2 }}" class="content">我的：QuickApp Kit</text>
  </div>
</template>

<script>
export default {
  private: { selected: 0 },
  onTabChange(event) {
    if (event && Number.isInteger(event.index)) this.selected = event.index
  },
}
</script>

<style>
.page { width: 300px; height: 520px; padding: 20px 14px 14px 14px; flex-direction: column; align-items: center; background-color: #ffffff; }
.title { margin: 8px 4px 2px 4px; font-size: 24px; color: #111111; }
.subtitle { margin: 2px 4px 18px 4px; font-size: 14px; color: #555555; }
.tabs { width: 276px; height: 48px; margin: 4px 2px 20px 2px; background-color: #2774c7; color: #ffffff; border-radius: 6px; }
.selection { margin: 4px; font-size: 16px; color: #111111; }
.content { margin: 18px 4px 4px 4px; font-size: 15px; color: #2774c7; }
</style>
