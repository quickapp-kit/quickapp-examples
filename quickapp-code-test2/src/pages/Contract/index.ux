<template>
  <div class="page">
    <text class="count">{{ count }}</text>
    <input type="button" value="更新状态" onclick="onUpdate" />

    <text if="{{ visible }}">条件节点</text>

    <div for="{{ (index, item) in items }}" tid="id">
      <text>{{ item.label }}</text>
    </div>
  </div>
</template>

<script>
export default {
  private: {
    count: 0,
    visible: true,
    items: [
      { id: 'a', label: 'A' },
      { id: 'b', label: 'B' },
    ],
  },

  onUpdate() {
    this.count += 1
    this.visible = !this.visible
    this.items = [this.items[1], this.items[0]]
  },
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
}

.count {
  color: #000000;
  font-size: 30px;
}
</style>
